        {
          "refId": "B",
          "expr": "max by (day) (site_daily_total{app=\"market\",kind=\"pageviews\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "day": "Day",
              "Value #A": "Visitors",
              "Value #B": "Page views"
            },
            "indexByName": {
              "day": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Day",
                "desc": false
              }
            ]
          }
        }
      ],
