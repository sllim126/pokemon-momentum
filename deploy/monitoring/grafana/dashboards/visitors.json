        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Day",
