{
  "uid": "momentum-jobs",
  "title": "Pokemon Momentum: Jobs & work",
  "tags": [
    "pokemon-momentum",
    "jobs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Pokemon Momentum",
      "type": "dashboards",
      "tags": [
        "pokemon-momentum"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Home lab",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Scheduled jobs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Did the jobs run?",
      "description": "Every scheduled job (docs/operator_runbook.txt). Overdue = no success for 1.5 x its interval plus an hour. Cron jobs report through scripts/monitoring/run_job.py, systemd jobs through collect_status.py.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(2 * (max by (task) (momentum_job_last_exit_code) != bool 0) + ((time() - max by (task) (momentum_job_last_success_timestamp_seconds)) > bool (1.5 * max by (task) (momentum_job_expected_interval_seconds) + 3600))) or (max by (task) (momentum_job_expected_interval_seconds) * 0 + 4)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "time() - max by (task) (momentum_job_last_success_timestamp_seconds)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (task) (momentum_job_last_exit_code)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (task) (momentum_job_last_duration_seconds)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "max by (task) (momentum_job_expected_interval_seconds)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "max by (task) (momentum_job_next_run_timestamp_seconds) * 1000",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "task": "Job",
              "Value #A": "Status",
              "Value #B": "Last success",
              "Value #C": "Exit code",
              "Value #D": "Took",
              "Value #E": "Runs every",
              "Value #F": "Next run (systemd)"
            },
            "indexByName": {
              "task": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "runner": true
            },
            "includeByName": {
              "task": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "Value #D": true,
              "Value #E": true,
              "Value #F": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "Overdue",
                        "color": "orange",
                        "index": 1
                      },
                      "2": {
                        "text": "Failed",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "Failed, overdue",
                        "color": "red",
                        "index": 3
                      },
                      "4": {
                        "text": "No run recorded yet",
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #D"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #E"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #F"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Status",
            "desc": true
          }
        ]
      },
      "id": 2
    },
