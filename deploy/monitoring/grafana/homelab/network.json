    {
      "type": "table",
      "title": "Network areas (UniFi's own verdict)",
      "description": "wan = the internet link, www = reaching the internet, lan = switches, wlan = Wi-Fi (warning when an AP is offline), vpn = VPN server.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (subsystem, status) ({__name__=~\"unpoller_site_.+\", subsystem!=\"\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "subsystem": "Area",
              "status": "Status"
            },
            "indexByName": {
              "subsystem": 0,
              "status": 1
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "runner": true
            },
            "includeByName": {
              "subsystem": true,
              "status": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-text"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "text": "ok",
                        "color": "green",
                        "index": 0
                      },
                      "warning": {
                        "text": "warning",
                        "color": "orange",
                        "index": 1
                      },
                      "error": {
                        "text": "error",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Devices",
      "description": "uap = access point, usw = switch or PDU, udm = gateway.",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name, type, model, ip, version) (unpoller_device_info)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (name, type) (unpoller_device_uptime_seconds > bool 0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
