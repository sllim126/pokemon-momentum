    {
      "type": "timeseries",
      "title": "Internet traffic (gateway WAN)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(unpoller_device_wan_receive_bytes_total[5m])) * 8",
          "legendFormat": "download",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(unpoller_device_wan_transmit_bytes_total[5m])) * 8",
          "legendFormat": "upload",
          "datasource": {
            "type": "prometheus",
