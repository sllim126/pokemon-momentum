    {
      "type": "stat",
      "title": "Disks healthy (SMART)",
      "description": "smartctl's health verdict for disks that report SMART. This server is a VM, so its disk is virtual and has none; the physical disks are on the Proxmox hosts.",
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(smartmon_device_smart_healthy and on (disk) (smartmon_device_smart_available == 1)) or vector(-1)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "FAILING",
                  "color": "red",
                  "index": 1
                },
                "-1": {
                  "text": "No SMART (virtual disk)",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "wideLayout": true
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "",
