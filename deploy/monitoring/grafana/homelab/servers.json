    {
      "type": "stat",
      "title": "Uptime",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
